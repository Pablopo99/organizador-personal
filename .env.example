# Token del bot, lo da @BotFather en Telegram
TELEGRAM_TOKEN=

# Clave de API de Anthropic, sacar de console.anthropic.com
ANTHROPIC_API_KEY=

# Tu Telegram user ID (numérico). Sacarlo escribiendo a @userinfobot
ALLOWED_USER_ID=

# Clave de API de Groq para transcripción de audio. Sacar de console.groq.com
# OPCIONAL: si no se rellena, el bot funcionará solo con mensajes de texto.
GROQ_API_KEY=

# Credenciales OAuth de Google Calendar. Crear en console.cloud.google.com.
# OPCIONAL: si no se rellenan, el bot funciona normal pero la sincronización con
# Google Calendar queda deshabilitada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
