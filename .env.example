# Token del bot, lo da @BotFather en Telegram
TELEGRAM_TOKEN=

# Clave de API de AiKit (AiKit → Configuración → API Keys, permiso 'inference').
AIKIT_API_KEY=
# Modelo de AiKit. OPCIONAL: por defecto "fast" (2-6 s). Alternativa: "expert".
AIKIT_MODEL=

# Tu Telegram user ID (numérico). Sacarlo escribiendo a @userinfobot
ALLOWED_USER_ID=

# Tu nombre, para personalizar el tono y el saludo matutino.
# OPCIONAL: por defecto "Pablo".
USER_NAME=

# Token secreto para el endpoint de Siri/atajos (siri_server). OBLIGATORIO:
# el bot no arranca sin él. Inventa una cadena larga y aleatoria.
SIRI_TOKEN=

# Clave de API de Groq para transcripción de audio. Sacar de console.groq.com
# OPCIONAL: si no se rellena, el bot funcionará solo con mensajes de texto.
GROQ_API_KEY=

# Credenciales OAuth de Google Calendar. Crear en console.cloud.google.com.
# OPCIONAL: si no se rellenan, el bot funciona normal pero la sincronización con
# Google Calendar queda deshabilitada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback OAuth. Debe apuntar a TU despliegue, no al de otra persona.
# Ej: https://tu-app.fly.dev/oauth/callback
GOOGLE_REDIRECT_URI=
